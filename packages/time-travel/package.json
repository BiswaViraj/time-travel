		"jsdom": "^30.1.3",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"tsdown": "^0.21.10",
		"typescript": "^5.9.3",
		"vitest": "^5.0.5"
	},
	"engines": {
		"node": ">=20.19.0"
	},
	"exports": {
		".": {
			"default": "./dist/index.mjs",
