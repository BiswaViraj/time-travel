{
	"devDependencies": {
		"@biomejs/biome": "2.4.9",
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"lefthook": "^2.2.2"
	},
	"name": "time-travel-workspace",
	"packageManager": "pnpm@12.14.0",
	"private": true,
	"scripts": {
		"build": "pnpm -r run build",
		"build:package": "pnpm --filter @biswaviraj/time-travel build",
		"build:watch": "pnpm --filter @biswaviraj/time-travel build:watch",
		"docs:build": "pnpm --filter @biswaviraj/time-travel-docs build",
		"docs:dev": "pnpm --filter @biswaviraj/time-travel-docs dev",
		"docs:typecheck": "pnpm --filter @biswaviraj/time-travel-docs typecheck",
		"format": "biome format .",
		"format:fix": "biome format --write .",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"test": "pnpm --filter @biswaviraj/time-travel test",
		"test:watch": "pnpm --filter @biswaviraj/time-travel test:watch",
		"typecheck": "pnpm --filter @biswaviraj/time-travel typecheck && pnpm run docs:typecheck"
	}
}
